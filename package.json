{
    "name": "obsidian-sync-mcp",
    "mcpName": "io.github.es617/obsidian-sync-mcp",
    "version": "0.9.1",
    "description": "Give any AI agent access to your Obsidian vault over MCP",
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jonocairns/obsidian-sync-mcp.git"
    },
    "keywords": [
        "mcp",
        "obsidian",
        "livesync",
        "couchdb",
        "claude",
        "ai"
    ],
    "engines": {
        "node": "^24.0.0"
    },
    "bin": {
        "obsidian-sync-mcp": "dist/main.js"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "lint": "oxlint --deny-warnings src/",
        "typecheck": "tsc -p tsconfig.json",
        "build": "tsup",
        "start": "node dist/main.js",
        "dev": "tsx src/main.ts",
        "test": "node --import tsx --test 'src/**/*.test.ts'",
        "benchmark:search": "node --import tsx scripts/benchmark-search.ts",
        "test:e2e": "node --import tsx --test test/e2e.test.ts",
        "test:couchdb": "tsx test/couchdb-obfuscation.e2e.ts && node --import tsx --test --test-timeout=120000 test/commonlib-contract.e2e.ts"
    },
    "dependencies": {
        "@vrtmrz/livesync-commonlib": "0.1.23",
        "better-sqlite3-multiple-ciphers": "^13.0.3",
        "fastmcp": "^4.16.12",
        "hono": "^4.13.2",
        "octagonal-wheels": "0.1.54",
        "yaml": "^2.9.0",
        "zod": "^3",
        "zod-to-json-schema": "^3.25.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.13.3",
        "oxlint": "1.79.0",
        "tsup": "^8",
        "tsx": "^4",
        "typescript": "^5",
        "@types/pouchdb": "6.4.2"
    }
}
